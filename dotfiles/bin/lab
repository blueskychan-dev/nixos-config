#!/usr/bin/env bash
# lab — one fzf menu for Incus (containers + VMs), libvirt/QEMU VMs and
#       hand-built QEMU VMs in ~/VMs (each with a vm.conf, see ~/VMs/AGENTS.md).
#   lab            pick an instance, then an action
#   lab <name>     jump straight to that instance's actions
# Keys: Enter = choose · Esc = back/quit · type to filter
set -uo pipefail
FZF=$(command -v fzf || echo "$HOME/.local/state/gcroots/fzf/bin/fzf")
VIRSH=(virsh -c qemu:///system)
P=$'\e[38;2;250;179;135m'; G=$'\e[38;2;166;227;161m'; D=$'\e[38;2;108;112;134m'; R=$'\e[0m'

fz() { "$FZF" --ansi --reverse --height=60% --border=rounded --info=hidden \
        --color='border:#45475a,pointer:#fab387,prompt:#fab387,hl:#fab387,hl+:#fab387,fg+:#cdd6f4,bg+:#313244,header:#a6adc8' "$@"; }
pause() { echo; read -rsn1 -p "${D}press any key…${R}"; echo; }

incus_ok() { incus list -f csv -c n >/dev/null 2>&1; }

# ── ~/VMs/*/vm.conf (hand-built QEMU VMs, see ~/VMs/AGENTS.md) ──────
VMROOT=${VMROOT:-$HOME/VMs}
conf_get() { ( set +u; NAME= DESC= START= ACTIONS= QMP= MATCH= TERMINAL=; source "$1/vm.conf" 2>/dev/null; eval "printf '%s' \"\${$2}\"" ); }
qmp() {  # qmp <dir> <command>  -> exit 0 if the socket answered
  local sock; sock=$(conf_get "$1" QMP); [[ -n $sock ]] || return 1
  [[ $sock = /* ]] || sock="$1/$sock"; [[ -S $sock ]] || return 1
  python3 -I - "$sock" "$2" <<'PY'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(1.5)
try:
    s.connect(sys.argv[1]); f = s.makefile("rw")
    f.readline()                                           # greeting
    for cmd in ("qmp_capabilities", sys.argv[2]):
        f.write(json.dumps({"execute": cmd}) + "\n"); f.flush()
        while "return" not in (r := json.loads(f.readline())) and "error" not in r: pass
    sys.exit(0)
except Exception:
    sys.exit(1)
PY
}
local_running() {
  qmp "$1" query-status && return 0
  local m pid; m=$(conf_get "$1" MATCH); [[ -n $m ]] || return 1
  for pid in $(pgrep -f -- "$m"); do              # only count real QEMU processes
    [[ $(cat /proc/$pid/comm 2>/dev/null) == qemu* ]] && return 0
  done
  return 1
}
local_launch() {  # local_launch <dir> <command>
  local d=$1 cmd=$2 term; term=$(conf_get "$d" TERMINAL)
  if [[ ${term:-yes} == no ]]; then
    (cd "$d" && setsid -f bash -c "$cmd" >"$d/lab.log" 2>&1)
  else
    setsid -f alacritty --class lab-vm --title "VM: $(conf_get "$d" NAME)" \
      -e bash -c "cd '$d' && $cmd; echo; read -rsn1 -p 'VM exited — press any key to close'" >/dev/null 2>&1
  fi
}
act_local() {
  local d=$1 name a acts
  name=$(conf_get "$d" NAME)
  if local_running "$d"; then
    a=$(printf '%s\n' "shutdown (ACPI)" "force off" "configure…" "open folder" "README" \
        | fz --prompt="$name › " --header="local · $name · running") || return
  else
    acts=$(conf_get "$d" ACTIONS)
    a=$( { echo "start"; [[ -n $acts ]] && tr ';' '\n' <<<"$acts" | sed 's/=.*//; s/^/start: /'; printf '%s\n' "configure…" "open folder" "README"; } \
        | fz --prompt="$name › " --header="local · $name · stopped · $(conf_get "$d" DESC)") || return
  fi
  case $a in
    start)        local_launch "$d" "$(conf_get "$d" START)" ;;
    "start: "*)   label=${a#start: }; cmd=$(tr ';' '\n' <<<"$(conf_get "$d" ACTIONS)" | grep -m1 "^${label}=" | cut -d= -f2-)
                  [[ -n $cmd ]] && local_launch "$d" "$cmd" ;;
    "shutdown (ACPI)") qmp "$d" system_powerdown && echo "${G}✓ shutdown requested${R}" || echo "no QMP — shut it down from inside the VM"; sleep 0.8 ;;
    "force off")  qmp "$d" quit || for pid in $(pgrep -f -- "$(conf_get "$d" MATCH)"); do
                    [[ $(cat /proc/$pid/comm 2>/dev/null) == qemu* ]] && kill "$pid"; done; sleep 0.5 ;;
    "open folder") setsid -f nemo "$d" >/dev/null 2>&1 ;;
    README)       less -R "$d/README.md" ;;
    "configure…") cfg_local "$d" ;;
  esac
}

rows() {
  if incus_ok; then
    incus list -f csv -c nst | while IFS=, read -r name state type; do
      icon="󰡨"; kind=ct; [[ $type == VIRTUAL-MACHINE ]] && { icon="󰍹"; kind=vm; }
      col=$D; [[ $state == RUNNING ]] && col=$G
      printf 'incus\t%s\t%s %s  %-22s %s%-8s%s %s\n' "$name" "$icon" "${P}incus${R}" "$name" "$col" "${state,,}" "$R" "${D}${kind}${R}"
    done
  else
    printf 'none\t-\t%s\n' "${D}⚠  incus: no permission yet (needs incus-admin group → rebuild + re-login)${R}"
  fi
  "${VIRSH[@]}" list --all --name 2>/dev/null | sed '/^$/d' | while read -r name; do
    state=$("${VIRSH[@]}" domstate "$name" 2>/dev/null)
    col=$D; [[ $state == running ]] && col=$G
    printf 'virsh\t%s\t󰍹 %s  %-22s %s%-8s%s %s\n' "$name" "${P}qemu${R} " "$name" "$col" "${state/shut off/off}" "$R" "${D}vm${R}"
  done
  for d in "$VMROOT"/*/; do
    d=${d%/}; [[ -f $d/vm.conf ]] || continue
    st="${D}off     ${R}"; local_running "$d" && st="${G}running ${R}"
    printf 'local\t%s\t󰖳 %s  %-22s %s %s\n' "$d" "${P}local${R}" "$(conf_get "$d" NAME)" "$st" "${D}qemu script${R}"
  done
  printf 'new\t-\t%s\n' "${P}+${R}  New Incus container…"
  printf 'gui\t-\t%s\n' "${P}${R}  Open virt-manager"
}

new_container() {
  local img name
  img=$(printf '%s\n' images:debian/13 images:ubuntu/24.04 images:fedora/43 images:archlinux images:alpine/edge images:nixos/unstable \
        | fz --prompt='image › ' --header='Image for the new container') || return
  name=$(fz --print-query --prompt='name › ' --header='Container name (Enter to create)' < /dev/null | head -1)
  [[ -n $name ]] || return
  incus launch "$img" "$name" && echo "${G}✓ created $name${R}"; pause
}

incus_wait() {  # wait until the instance's systemd has finished booting (max ~30s)
  local i; for i in $(seq 30); do
    incus exec "$1" -- systemctl is-system-running --quiet --wait 2>/dev/null && return 0
    incus exec "$1" -- true 2>/dev/null && [[ $i -gt 5 ]] && return 0; sleep 1
  done; return 0
}

login_as() {  # pick a user inside the instance, then do a real login session as them
  local n=$1 u
  u=$(incus exec "$n" -- getent passwd 2>/dev/null \
      | awk -F: '$3==0 || ($3>=1000 && $3<65534) {printf "%s\t%s  %-16s %s\n", $1, ($3==0?"󰒃":""), $1, $6}' \
      | fz --delimiter=$'\t' --with-nth=2 --prompt="$n › login as › " \
           --header="Who do you want to log in as? · Esc: back") || return
  u=${u%%$'\t'*}
  clear
  exec incus exec "$n" -t -- login -f "$u"
}

act_incus() {
  local n=$1 state type a
  state=$(incus list "^${n}\$" -f csv -c s); type=$(incus list "^${n}\$" -f csv -c t)
  if [[ $state == RUNNING ]]; then
    a=$(printf '%s\n' "shell" "stop" "restart" "snapshot" "configure…" "info" $([[ $type == VIRTUAL-MACHINE ]] && echo console) \
        | fz --prompt="$n › " --header="incus · $n · ${state,,}") || return
  else
    a=$(printf '%s\n' "start + shell" "start" "snapshot" "configure…" "info" | fz --prompt="$n › " --header="incus · $n · ${state,,}") || return
  fi
  case $a in
    "start + shell") incus start "$n" && incus_wait "$n" && login_as "$n" ;;
    shell)    login_as "$n" ;;
    console)  exec incus console "$n" --type=vga ;;
    start|stop|restart) incus "$a" "$n" && echo "${G}✓ $a $n${R}"; sleep 0.6 ;;
    snapshot) incus snapshot create "$n" "snap-$(date +%Y%m%d-%H%M)" && echo "${G}✓ snapshot saved${R}"; pause ;;
    info)     incus info "$n" | less -R ;;
    "configure…") cfg_incus "$n" ;;
  esac
}

act_virsh() {
  local n=$1 state a
  state=$("${VIRSH[@]}" domstate "$n" 2>/dev/null)
  if [[ $state == running ]]; then
    a=$(printf '%s\n' "display (virt-manager)" "serial console" "shutdown" "force off" "reboot" "snapshot" "configure…" "info" \
        | fz --prompt="$n › " --header="qemu · $n · $state") || return
  else
    a=$(printf '%s\n' "start + display" "start" "snapshot" "configure…" "info" | fz --prompt="$n › " --header="qemu · $n · $state") || return
  fi
  case $a in
    "start + display") "${VIRSH[@]}" start "$n" >/dev/null && setsid -f virt-manager --connect qemu:///system --show-domain-console "$n" >/dev/null 2>&1 ;;
    "display (virt-manager)") setsid -f virt-manager --connect qemu:///system --show-domain-console "$n" >/dev/null 2>&1 ;;
    "serial console") exec "${VIRSH[@]}" console "$n" ;;
    start)     "${VIRSH[@]}" start "$n" ;;
    shutdown)  "${VIRSH[@]}" shutdown "$n" ;;
    "force off") "${VIRSH[@]}" destroy "$n" ;;
    reboot)    "${VIRSH[@]}" reboot "$n" ;;
    snapshot)  "${VIRSH[@]}" snapshot-create-as "$n" "snap-$(date +%Y%m%d-%H%M)" && echo "${G}✓ snapshot saved${R}"; pause ;;
    info)      { "${VIRSH[@]}" dominfo "$n"; "${VIRSH[@]}" domifaddr "$n" 2>/dev/null; } | less -R ;;
    "configure…") cfg_virsh "$n" ;;
  esac
  sleep 0.4
}

# ── configure… (spec, disks, shared folders, SMBIOS, raw config) ─────
EDIT=$(command -v nvim || command -v vim || command -v nano || echo vi)
ask() {  # ask "<prompt>" "<default>" "<header>"  -> typed value (Enter keeps default)
  "$FZF" --print-query --query "${2:-}" --prompt "$1 › " --header "${3:-Enter to confirm · Esc to cancel}" \
    --reverse --height=30% --border=rounded --info=hidden --no-sort \
    --color='border:#45475a,prompt:#fab387,header:#a6adc8' < /dev/null | head -1
}
okmsg() { echo "${G}✓ $*${R}"; }
pick_dir() {  # choose a host folder: type a path, or pick from home folders
  { echo "$HOME/Share"; find "$HOME" -mindepth 1 -maxdepth 2 -type d -not -path '*/.*' 2>/dev/null | sort; } \
    | "$FZF" --print-query --reverse --height=60% --border=rounded --prompt='host folder › ' \
        --header='Pick or type a host path (created if missing)' | tail -1
}

# libvirt XML edits go through python so the domain stays valid; then `virsh define`.
virsh_xml_edit() {  # virsh_xml_edit <vm> <python-snippet using `root` (ElementTree)> [args…]
  local n=$1 code=$2; shift 2
  local tmp; tmp=$(mktemp --suffix=.xml)
  "${VIRSH[@]}" dumpxml --inactive --security-info "$n" > "$tmp" || return 1
  python3 -I - "$tmp" "$@" <<PY || { rm -f "$tmp"; return 1; }
import sys, xml.etree.ElementTree as ET
path, args = sys.argv[1], sys.argv[2:]
tree = ET.parse(path); root = tree.getroot()
def sub(parent, tag, **attr):
    el = parent.find(tag)
    if el is None: el = ET.SubElement(parent, tag)
    for k, v in attr.items(): el.set(k, v)
    return el
$code
tree.write(path)
PY
  "${VIRSH[@]}" define "$tmp" >/dev/null && rm -f "$tmp"
}

cfg_virsh() {
  local n=$1 a state
  while :; do
    state=$("${VIRSH[@]}" domstate "$n" 2>/dev/null)
    a=$(printf '%s\n' "CPU & memory…" "add a disk…" "shared folder (virtiofs)…" "SMBIOS identity…" \
          "show hardware" "edit XML (virsh edit)" "open virt-manager details" \
        | fz --prompt="$n › configure › " --header="qemu · $n · $state · changes apply on next boot") || return
    case $a in
      "CPU & memory…")
        local cpus mem
        cpus=$(ask "vCPUs" "$("${VIRSH[@]}" dominfo "$n" | awk '/^CPU\(s\)/{print $2}')" "Number of virtual CPUs (host has $(nproc))") || continue
        mem=$(ask "RAM (GiB)" "$(( $("${VIRSH[@]}" dominfo "$n" | awk '/^Max memory/{print $3}') / 1048576 ))" "Memory in GiB (host has $(free -g | awk '/^Mem:/{print $2}') GiB)") || continue
        [[ $cpus =~ ^[0-9]+$ && $mem =~ ^[0-9]+$ ]] || { echo "${RD}numbers only${R}"; sleep 1; continue; }
        virsh_xml_edit "$n" '
c, m = args
v = root.find("vcpu"); v.text = c; v.attrib.pop("current", None)
for tag in ("memory", "currentMemory"):
    e = sub(root, tag, unit="KiB"); e.text = str(int(m) * 1048576)
top = root.find("cpu/topology")
if top is not None:   # keep topology consistent: 1 socket, threads as before
    t = int(top.get("threads", "1")); top.set("sockets", "1"); top.set("dies", "1"); top.set("cores", str(max(1, int(c) // t)))
' "$cpus" "$mem" && okmsg "$n: $cpus vCPU, $mem GiB (next boot)"; sleep 1 ;;
      "add a disk…")
        local size name dir dev path
        size=$(ask "size (GiB)" "32" "New empty qcow2 disk (thin: only uses space as it fills)") || continue
        name=$(ask "file name" "$n-data$(date +%H%M).qcow2") || continue
        dir=$(dirname "$("${VIRSH[@]}" domblklist "$n" --details | awk '$2=="disk"{print $4; exit}')")
        [[ -d $dir ]] || dir=/var/lib/libvirt/images
        dir=$(ask "folder" "$dir" "Where to store the disk file") || continue
        path="$dir/$name"
        for dev in vdb vdc vdd vde vdf vdg; do "${VIRSH[@]}" domblklist "$n" | awk '{print $1}' | grep -qx $dev || break; done
        if [[ -w $dir ]]; then qemu-img create -q -f qcow2 "$path" "${size}G"; else sudo qemu-img create -q -f qcow2 "$path" "${size}G"; fi \
          && "${VIRSH[@]}" attach-disk "$n" "$path" "$dev" --driver qemu --subdriver qcow2 --targetbus virtio --config >/dev/null \
          && okmsg "attached $path as /dev/$dev (format it inside the guest)"; read -rsn1 -p "${D}press any key…${R}" ;;
      "shared folder (virtiofs)…")
        local host tag
        host=$(pick_dir) || continue; [[ -n $host ]] || continue
        mkdir -p "$host" 2>/dev/null
        tag=$(ask "tag" "$(basename "$host" | tr -c 'a-zA-Z0-9_-\n' '_')" "Name the guest uses to mount it") || continue
        virsh_xml_edit "$n" '
host, tag, binary = args
mb = sub(root, "memoryBacking"); sub(mb, "source", type="memfd"); sub(mb, "access", mode="shared")
dev = root.find("devices")
fs = ET.SubElement(dev, "filesystem", type="mount", accessmode="passthrough")
drv = ET.SubElement(fs, "driver", type="virtiofs")
ET.SubElement(fs, "binary", path=binary)
ET.SubElement(fs, "source", dir=host)
ET.SubElement(fs, "target", dir=tag)
' "$host" "$tag" "$(command -v virtiofsd)" \
          && { okmsg "shared $host as \"$tag\" (next boot)"
               echo "   in the guest:  ${P}sudo mount -t virtiofs $tag /mnt/$tag${R}"
               echo "   or in /etc/fstab:  ${D}$tag  /mnt/$tag  virtiofs  defaults,nofail  0 0${R}"; }
        read -rsn1 -p "${D}press any key…${R}" ;;
      "SMBIOS identity…")
        local mode
        mode=$(printf '%s\n' "custom (manufacturer / product / serial…)" "copy this PC's real SMBIOS" "remove (QEMU defaults)" \
               | fz --prompt="SMBIOS › " --header="What the guest sees as its motherboard/BIOS") || continue
        case $mode in
          custom*)
            local mf pr ver ser fam
            mf=$(ask "manufacturer" "ASUSTeK COMPUTER INC.") || continue
            pr=$(ask "product" "ROG STRIX B550-F GAMING") || continue
            ver=$(ask "version" "Rev 1.xx") || continue
            ser=$(ask "serial" "$(tr -dc 'A-Z0-9' </dev/urandom | head -c 15)") || continue
            fam=$(ask "family" "Desktop") || continue
            virsh_xml_edit "$n" '
mf, pr, ver, ser, fam = args
old = root.find("sysinfo")
if old is not None: root.remove(old)
si = ET.Element("sysinfo", type="smbios")
root.insert(list(root).index(root.find("os")), si)
sysel = ET.SubElement(si, "system")
for k, v in (("manufacturer", mf), ("product", pr), ("version", ver), ("serial", ser), ("family", fam)):
    ET.SubElement(sysel, "entry", name=k).text = v
bb = ET.SubElement(si, "baseBoard")
for k, v in (("manufacturer", mf), ("product", pr), ("version", ver), ("serial", ser)):
    ET.SubElement(bb, "entry", name=k).text = v
sub(root.find("os"), "smbios", mode="sysinfo")
' "$mf" "$pr" "$ver" "$ser" "$fam" && okmsg "SMBIOS set (next boot)" ;;
          copy*)  virsh_xml_edit "$n" 'sub(root.find("os"), "smbios", mode="host")' && okmsg "guest will see this PC's SMBIOS (next boot)" ;;
          remove*) virsh_xml_edit "$n" '
o = root.find("os"); s = o.find("smbios")
if s is not None: o.remove(s)
si = root.find("sysinfo")
if si is not None: root.remove(si)
' && okmsg "SMBIOS back to QEMU defaults" ;;
        esac; sleep 1 ;;
      "show hardware")
        { "${VIRSH[@]}" dominfo "$n"; echo; echo "Disks:"; "${VIRSH[@]}" domblklist "$n" --details
          echo "Shared folders:"; "${VIRSH[@]}" dumpxml "$n" | grep -A3 '<filesystem' | grep -oE "(dir|path)='[^']*'" | paste - - - 2>/dev/null
          echo; echo "SMBIOS:"; "${VIRSH[@]}" dumpxml "$n" | sed -n '/<sysinfo/,/<\/sysinfo>/p; /<smbios/p'; } | less -R ;;
      "edit XML (virsh edit)") EDITOR=$EDIT "${VIRSH[@]}" edit "$n" ;;
      "open virt-manager details") setsid -f virt-manager --connect qemu:///system --show-domain-editor "$n" >/dev/null 2>&1 ;;
    esac
  done
}

cfg_incus() {
  local n=$1 a type vm=0
  type=$(incus list "^${n}\$" -f csv -c t); [[ $type == VIRTUAL-MACHINE ]] && vm=1
  while :; do
    a=$(printf '%s\n' "CPU & memory…" "add a disk (storage volume)…" "shared folder…" \
          $( ((vm)) && echo "SMBIOS identity…") "show config" "edit config (YAML)" \
        | fz --prompt="$n › configure › " --header="incus · $n · $( ((vm)) && echo VM || echo container) · CPU/RAM apply live on containers") || return
    case $a in
      "CPU & memory…")
        local cpus mem
        cpus=$(ask "CPU limit" "$(incus config get "$n" limits.cpu)" "Number of CPUs (empty = no limit; host has $(nproc))") || continue
        mem=$(ask "RAM limit" "$(incus config get "$n" limits.memory)" "e.g. 4GiB, 512MiB (empty = no limit)") || continue
        if [[ -n $cpus ]]; then incus config set "$n" limits.cpu="$cpus"; else incus config unset "$n" limits.cpu; fi
        if [[ -n $mem ]]; then incus config set "$n" limits.memory="$mem"; else incus config unset "$n" limits.memory; fi
        okmsg "$n: cpu=${cpus:-∞} memory=${mem:-∞}"; sleep 1 ;;
      "add a disk (storage volume)…")
        local size vol mnt
        size=$(ask "size" "20GiB" "New volume in the default pool") || continue
        vol=$(ask "volume name" "$n-data") || continue
        if ((vm)); then
          incus storage volume create default "$vol" size="$size" --type=block \
            && incus config device add "$n" "$vol" disk pool=default source="$vol" >/dev/null \
            && okmsg "attached block volume $vol (format it inside the VM)"
        else
          mnt=$(ask "mount path" "/mnt/$vol" "Where it appears inside the container") || continue
          incus storage volume create default "$vol" size="$size" \
            && incus config device add "$n" "$vol" disk pool=default source="$vol" path="$mnt" >/dev/null \
            && okmsg "mounted $vol at $mnt"
        fi; read -rsn1 -p "${D}press any key…${R}" ;;
      "shared folder…")
        local host tag mnt
        host=$(pick_dir) || continue; [[ -n $host ]] || continue
        mkdir -p "$host" 2>/dev/null
        tag=$(ask "device name" "share-$(basename "$host" | tr -c 'a-zA-Z0-9_-\n' '_')") || continue
        mnt=$(ask "path in guest" "/mnt/$(basename "$host")") || continue
        if ((vm)); then incus config device add "$n" "$tag" disk source="$host" path="$mnt" >/dev/null
        else incus config device add "$n" "$tag" disk source="$host" path="$mnt" shift=true >/dev/null; fi \
          && okmsg "$host → $mnt"; read -rsn1 -p "${D}press any key…${R}" ;;
      "SMBIOS identity…")
        local mf pr ser
        mf=$(ask "manufacturer" "ASUSTeK COMPUTER INC.") || continue
        pr=$(ask "product" "ROG STRIX B550-F GAMING") || continue
        ser=$(ask "serial" "$(tr -dc 'A-Z0-9' </dev/urandom | head -c 15)") || continue
        incus config set "$n" raw.qemu="-smbios type=1,manufacturer=$mf,product=$pr,serial=$ser -smbios type=2,manufacturer=$mf,product=$pr,serial=$ser" \
          && okmsg "SMBIOS set (applies on next VM start)"; sleep 1 ;;
      "show config") incus config show "$n" --expanded | less -R ;;
      "edit config (YAML)") EDITOR=$EDIT incus config edit "$n" ;;
    esac
  done
}

cfg_local() {
  local d=$1 f
  f=$( { printf '%s\n' start.sh vm.conf README.md; [[ -f $d/identity.env ]] && echo "identity.env  ⚠ changing it can re-trigger Windows activation"; } \
       | fz --prompt="$(conf_get "$d" NAME) › configure › " \
            --header="Hand-built QEMU: CPU, RAM, disks, shares and SMBIOS live in start.sh") || return
  f=${f%%  *}
  "$EDIT" "$d/$f"
}

# direct: lab <name>
if [[ $# -gt 0 ]]; then
  if incus_ok && incus list -f csv -c n | grep -qx "$1"; then act_incus "$1"; exit; fi
  if "${VIRSH[@]}" list --all --name | grep -qx "$1"; then act_virsh "$1"; exit; fi
  echo "lab: no instance called '$1'" >&2; exit 1
fi

while :; do
  pick=$(rows | fz --delimiter=$'\t' --with-nth=3 --prompt='lab › ' \
          --header='Enter: actions · Esc: quit') || exit 0
  src=${pick%%$'\t'*}; rest=${pick#*$'\t'}; name=${rest%%$'\t'*}
  case $src in
    incus) act_incus "$name" ;;
    virsh) act_virsh "$name" ;;
    local) act_local "$name" ;;
    new)   new_container ;;
    gui)   setsid -f virt-manager --connect qemu:///system >/dev/null 2>&1; exit 0 ;;
  esac
done
